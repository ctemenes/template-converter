{
  "schemaVersion": "1.0",
  "name": "01-policy-renewal-notice",
  "source": {
    "file": "01-policy-renewal-notice.docx",
    "format": "docx"
  },
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "marginsMm": {
      "top": 25.4,
      "right": 20,
      "bottom": 25.4,
      "left": 20
    }
  },
  "variables": [
    {
      "name": "letterDate",
      "type": "date",
      "sourceNames": [
        "Letter_Date"
      ],
      "format": "d MMMM yyyy"
    },
    {
      "name": "title",
      "type": "string",
      "sourceNames": [
        "Title"
      ]
    },
    {
      "name": "firstName",
      "type": "string",
      "sourceNames": [
        "First_Name"
      ]
    },
    {
      "name": "lastName",
      "type": "string",
      "sourceNames": [
        "Last_Name"
      ]
    },
    {
      "name": "addressLine1",
      "type": "string",
      "sourceNames": [
        "Address_Line_1"
      ]
    },
    {
      "name": "suburb",
      "type": "string",
      "sourceNames": [
        "Suburb"
      ]
    },
    {
      "name": "state",
      "type": "string",
      "sourceNames": [
        "State"
      ]
    },
    {
      "name": "postcode",
      "type": "string",
      "sourceNames": [
        "Postcode"
      ]
    },
    {
      "name": "productName",
      "type": "string",
      "sourceNames": [
        "Product_Name"
      ]
    },
    {
      "name": "policyNumber",
      "type": "string",
      "sourceNames": [
        "Policy_Number"
      ]
    },
    {
      "name": "expiryDate",
      "type": "date",
      "sourceNames": [
        "Expiry_Date"
      ],
      "format": "d MMMM yyyy"
    },
    {
      "name": "renewalPremium",
      "type": "currency",
      "sourceNames": [
        "Renewal_Premium"
      ],
      "format": "$#,##0.00"
    },
    {
      "name": "dueDate",
      "type": "date",
      "sourceNames": [
        "Due_Date"
      ],
      "format": "d MMMM yyyy"
    },
    {
      "name": "levyAmount",
      "type": "currency",
      "sourceNames": [
        "Levy_Amount"
      ]
    },
    {
      "name": "autoRenew",
      "type": "string",
      "sourceNames": [
        "Auto_Renew"
      ]
    }
  ],
  "header": [],
  "footer": [
    {
      "text": "Harbourline Mutual Ltd ABN 00 000 000 000. Page "
    },
    {
      "sys": "pageNumber"
    },
    {
      "text": " of "
    },
    {
      "sys": "pageCount"
    }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "style": "Heading1",
      "content": [
        {
          "text": "Your policy is due for renewal"
        }
      ]
    },
    {
      "type": "paragraph",
      "style": "Normal",
      "content": [
        {
          "var": "letterDate",
          "format": "d MMMM yyyy"
        }
      ]
    },
    {
      "type": "paragraph",
      "style": "Address",
      "content": [
        {
          "var": "title"
        },
        {
          "text": " "
        },
        {
          "var": "firstName"
        },
        {
          "text": " "
        },
        {
          "var": "lastName"
        }
      ]
    },
    {
      "type": "paragraph",
      "style": "Address",
      "content": [
        {
          "var": "addressLine1"
        }
      ]
    },
    {
      "type": "paragraph",
      "style": "Address",
      "content": [
        {
          "var": "suburb"
        },
        {
          "text": " "
        },
        {
          "var": "state"
        },
        {
          "text": " "
        },
        {
          "var": "postcode"
        }
      ]
    },
    {
      "type": "paragraph",
      "style": "Normal",
      "content": [
        {
          "text": "Dear "
        },
        {
          "var": "firstName"
        },
        {
          "text": ","
        }
      ]
    },
    {
      "type": "paragraph",
      "style": "Normal",
      "content": [
        {
          "text": "Your "
        },
        {
          "var": "productName"
        },
        {
          "text": " policy "
        },
        {
          "var": "policyNumber"
        },
        {
          "text": " expires on "
        },
        {
          "var": "expiryDate",
          "format": "d MMMM yyyy"
        },
        {
          "text": ". To keep your cover in place, your renewal premium of "
        },
        {
          "var": "renewalPremium",
          "format": "$#,##0.00"
        },
        {
          "text": " is due by "
        },
        {
          "var": "dueDate",
          "format": "d MMMM yyyy"
        },
        {
          "text": "."
        }
      ]
    },
    {
      "type": "conditional",
      "when": {
        "var": "state",
        "op": "eq",
        "value": "QLD"
      },
      "blocks": [
        {
          "type": "paragraph",
          "style": "Normal",
          "content": [
            {
              "text": "Because your property is in Queensland, your premium includes the state emergency levy of "
            },
            {
              "var": "levyAmount"
            },
            {
              "text": "."
            }
          ]
        }
      ]
    },
    {
      "type": "conditional",
      "when": {
        "var": "autoRenew",
        "op": "eq",
        "value": "Y"
      },
      "blocks": [
        {
          "type": "paragraph",
          "style": "Normal",
          "content": [
            {
              "text": "We will debit your nominated account on the due date. You do not need to do anything."
            }
          ]
        }
      ],
      "else": [
        {
          "type": "paragraph",
          "style": "Normal",
          "content": [
            {
              "text": "Please pay by the due date using one of the options on the back of this notice."
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "style": "Normal",
      "content": [
        {
          "text": "If your details have changed, call us on 1300 000 000."
        }
      ]
    },
    {
      "type": "paragraph",
      "style": "Normal",
      "content": [
        {
          "text": "Yours sincerely,"
        }
      ]
    },
    {
      "type": "paragraph",
      "style": "Normal",
      "content": [
        {
          "text": "Customer Care Team",
          "bold": true
        }
      ]
    }
  ],
  "rules": []
}